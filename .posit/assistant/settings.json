{
  "permission": {
    "edit": {
      "*.md": "allow",
      "*.qmd": "allow",
      "*.R": "allow",
      "*.sh": "allow"
    },
    "executeCode": {
      "*": "allow"
    },
    "bash": {
      "Rscript *": "allow",
      "mkdir *": "allow",
      "dmesg *": "allow",
      "grep *": "allow",
      "tail *": "allow",
      "quarto render *": "allow",
      "*": "allow"
    }
  },
  "sandbox": {
    "enabled": false
  }
}